{
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/index.css",
  "tailwindAttributes": [
    "className",
    "customClassProp",
    "styles",
    "divContainerClasses",
    "textContainerClasses",
    "imageContainerClasses",
    "sectionClasses",
    "h2Classes",
    "pClasses",
    "CTAClasses"
  ],
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf"
}
